# OCI image containing a compatible `rdvp` executable.
# Pin production deployments to an immutable digest.
RDVP_IMAGE=

# Rendezvous private key generated by `make genkey`.
RDVP_PK=

# Public IP address or DNS name announced to peers.
ANNOUNCE_SERVER=

# Emitter credentials. Do not commit production values.
EMITTER_SECRET_KEY=
EMITTER_LICENSE=
